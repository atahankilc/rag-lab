# Copy to .env and fill in. Never commit .env.

# --- Your RAG system ---
OPENAI_API_KEY=sk-...

# --- Benchmark judge (read by vendor/EnterpriseRAG-Bench eval scripts) ---
LLM_PROVIDER=openai
LLM_API_KEY=${OPENAI_API_KEY}
# Judge models. Defaults are gpt-5.4 / gpt-5-mini. Keep the judge FIXED across
# experiments, otherwise scores are not comparable.
# LLM_MODEL_NAME=gpt-5.4
# CHEAP_LLM_MODEL_NAME=gpt-5-mini

# --- RAG Lab (viz/) ---
# Local-only Postgres + PostgREST. Generate secrets with: openssl rand -hex 24
LAB_PG_PORT=54329
LAB_API_PORT=3301
LAB_DB_PASSWORD=change-me
LAB_AUTHENTICATOR_PASSWORD=change-me
LAB_BACKEND_PASSWORD=change-me
# PostgREST JWT secret, at least 32 characters. Write calls are signed with it.
LAB_JWT_SECRET=change-me-to-at-least-32-characters-long
